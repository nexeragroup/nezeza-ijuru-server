# =============================================================================
# APPLICATION
# =============================================================================

NODE_ENV=development
DISABLE_POST_CSRF=false

APP_NAME=default-server
APP_URL=http://localhost:3300
CLIENT_URL=http://localhost:4200

HOST=0.0.0.0
PORT=3300

# api | worker | all
APP_ROLE=all

# One-time developer bootstrap (used by `pnpm run db:bootstrap`)
# INITIAL_ADMIN_FIRSTNAME=
# INITIAL_ADMIN_LASTNAME=
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_PASSWORD_HASH=

# error | warn | log | debug | verbose
LOG_LEVEL=debug


# =============================================================================
# SWAGGER / OPENAPI
# =============================================================================

SWAGGER_ENABLED=true

# With the global API prefix already set to /api/v1, prefer just "docs".
# Final URL: http://localhost:3300/api/v1/docs
SWAGGER_PATH=docs

SWAGGER_AUTH_ENABLED=true
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=<ROTATE_AND_SET_SWAGGER_PASSWORD>


# =============================================================================
# DATABASE - POSTGRESQL
# =============================================================================

DATABASE_ENABLED=true
DATABASE_TYPE=postgres

DATABASE_HOST=localhost
DATABASE_PORT=5432

DATABASE_USERNAME=yvesndar
DATABASE_PASSWORD=dev_password
DATABASE_NAME=default

# Development only.
# Keep false in staging/production and use migrations.
DATABASE_SYNCHRONIZE=true
DATABASE_MIGRATIONS=false

DATABASE_LOGGING=false

DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=5000


# =============================================================================
# DATABASE - TLS
# =============================================================================

DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=


# =============================================================================
# DATABASE - READ REPLICA
# =============================================================================

DATABASE_REPLICA_HOST=
DATABASE_REPLICA_PORT=5432
DATABASE_REPLICA_USERNAME=
DATABASE_REPLICA_PASSWORD=
DATABASE_REPLICA_NAME=


# =============================================================================
# REDIS
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379

REDIS_USERNAME=
REDIS_PASSWORD=

REDIS_TLS=false

REDIS_NAMESPACE=centralized-api

REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000


# =============================================================================
# CACHE
# =============================================================================

CACHE_ENABLED=true

CACHE_NAMESPACE=cache
CACHE_TTL_SECONDS=300
CACHE_SCAN_COUNT=100


# =============================================================================
# QUEUE - BULLMQ
# =============================================================================

QUEUE_ENABLED=true

QUEUE_PREFIX=centralized-api

QUEUE_EVENT_NAME=events.v1
QUEUE_DLQ_NAME=events.dlq.v1

QUEUE_CONCURRENCY=5

QUEUE_ATTEMPTS=5

QUEUE_BACKOFF_DELAY_MS=1000
QUEUE_BACKOFF_JITTER=0.2

QUEUE_STACK_TRACE_LIMIT=20

QUEUE_MAX_STALLED_COUNT=1
QUEUE_LOCK_DURATION_MS=30000

QUEUE_FAILURE_RECONCILE_LIMIT=1000


# =============================================================================
# QUEUE - JOB RETENTION
# =============================================================================

QUEUE_COMPLETED_RETENTION_SECONDS=86400
QUEUE_COMPLETED_RETENTION_COUNT=10000

QUEUE_FAILED_RETENTION_SECONDS=604800
QUEUE_FAILED_RETENTION_COUNT=50000


# =============================================================================
# QUEUE - DEAD LETTER RETENTION
# =============================================================================

QUEUE_DLQ_COMPLETED_RETENTION_SECONDS=86400
QUEUE_DLQ_COMPLETED_RETENTION_COUNT=10000

QUEUE_DLQ_FAILED_RETENTION_SECONDS=604800
QUEUE_DLQ_FAILED_RETENTION_COUNT=50000


# =============================================================================
# TRANSACTIONAL OUTBOX
# =============================================================================

OUTBOX_ENABLED=true

OUTBOX_BATCH_SIZE=50
OUTBOX_PUBLISH_CONCURRENCY=5

OUTBOX_POLL_INTERVAL_MS=1000

OUTBOX_LEASE_DURATION_MS=30000

OUTBOX_MAX_ATTEMPTS=10

OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000

OUTBOX_RETENTION_DAYS=30


# =============================================================================
# OBJECT STORAGE - S3 / S3-COMPATIBLE
# =============================================================================

STORAGE_ENABLED=false

# Leave empty for normal AWS S3.
# Set for MinIO or another S3-compatible service.
STORAGE_ENDPOINT=

STORAGE_REGION=us-east-1
STORAGE_BUCKET=

# May remain empty when AWS IAM / SDK credential providers are used.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SESSION_TOKEN=

STORAGE_FORCE_PATH_STYLE=false
STORAGE_TLS=true

STORAGE_MAX_ATTEMPTS=3

# Maximum supported by the service: 604800 seconds / 7 days.
STORAGE_PRESIGNED_EXPIRY_SECONDS=900


# =============================================================================
# JWT
# =============================================================================

JWT_SECRET=<ROTATE_AND_SET_JWT_SECRET>

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# =============================================================================
# SESSION
# =============================================================================

SESSION_SECRET=<ROTATE_AND_SET_SESSION_SECRET>

SESSION_COOKIE_NAME=connect.sid

SECURE_COOKIES=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax


# =============================================================================
# CSRF
# =============================================================================

CSRF_SECRET=<ROTATE_AND_SET_CSRF_SECRET>
CSRF_COOKIE_DOMAIN=


# =============================================================================
# MFA / SECRET PROTECTION
# =============================================================================

# Generate using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=<ROTATE_AND_SET_32_BYTE_BASE64_KEY>

# Used by versioned encrypted-secret envelopes.
MFA_ENCRYPTION_KEY_ID=primary

# Example during key rotation:
# MFA_PREVIOUS_ENCRYPTION_KEYS=2026-08:<base64-key>,2026-07:<base64-key>
MFA_PREVIOUS_ENCRYPTION_KEYS=


# =============================================================================
# AUTHENTICATION POLICY
# =============================================================================

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_TIME_MINUTES=15


# =============================================================================
# PASSWORD HASHING - ARGON2ID
# =============================================================================

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# More predictable CPU usage for a general-purpose server.
ARGON2_PARALLELISM=1

ARGON2_HASH_LENGTH=32

# Protects against extremely large password payloads.
ARGON2_MAX_PASSWORD_BYTES=4096


# =============================================================================
# HTTP SECURITY
# =============================================================================

HELMET_ENABLED=true

# Preferred trust-proxy configuration.
#
# 0 = direct NestJS
# 1 = Internet -> Nginx -> NestJS
# 2 = Internet -> LB -> Nginx -> NestJS
TRUST_PROXY_HOPS=0

# Temporary legacy compatibility.
TRUST_PROXY=false


# =============================================================================
# RATE LIMITING
# =============================================================================

THROTTLE_TTL=60
THROTTLE_LIMIT=100

LOGIN_THROTTLE_LIMIT=5


# =============================================================================
# INTERNAL SERVER AUTHENTICATION
# =============================================================================

SERVER_API_KEY=<ROTATE_AND_SET_SERVER_API_KEY>


# =============================================================================
# DEFAULT GATEWAY JWE TRANSPORT
# =============================================================================

# Opt in only after the server and Default gateway have exchanged public keys.
CRYPTO_ENABLED=false

SERVER_ID=default-server
# This is the same key id configured as CLIENT_KEY_ID in Default/gateway.
SERVER_KEY_ID=client-encryption-v1
SERVER_PRIVATE_KEY_PATH=./keys/server-private.pem

GATEWAY_ID=default-gateway
GATEWAY_KEY_ID=gateway-encryption-v1
GATEWAY_PUBLIC_KEY_PATH=./keys/gateway-public.pem

CRYPTO_MESSAGE_TTL_SECONDS=120


# =============================================================================
# GATEWAY
# =============================================================================

GATEWAY_ENABLED=true

GATEWAY_BASE_URL=http://localhost:3600/api/v1
GATEWAY_API_KEY=<ROTATE_AND_SET_GATEWAY_API_KEY>

GATEWAY_TIMEOUT=10000

GATEWAY_RETRY_ATTEMPTS=3
GATEWAY_RETRY_DELAY=1000

GATEWAY_TIN=999910258
GATEWAY_BHF_ID=00


# =============================================================================
# EBM
# =============================================================================

EBM_DEFAULT_INSURANCE_RATE=20
EBM_DEFAULT_CUSTOMER_TIN=999999999

EBM_OPERATOR_ID=Admin
EBM_OPERATOR_NAME=Admin


# =============================================================================
# CORS
# =============================================================================

CORS_ORIGIN=http://localhost:4200,http://localhost:4300,http://localhost:3001

CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS

CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

CORS_ALLOW_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization,X-XSRF-TOKEN,X-Session-Id,X-API-Key,X-Request-Id,X-Trace-Id

CORS_EXPOSE_HEADERS=Content-Length,Content-Range,X-Request-Id,X-Trace-Id,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset,Retry-After


# =============================================================================
# MAIL
# =============================================================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

MAIL_USER=nexeragrouprwanda@gmail.com
MAIL_PASS=<ROTATE_AND_SET_MAIL_APP_PASSWORD>

MAIL_FROM=nexeragrouprwanda@gmail.com

MAIL_SECURE=false
MAIL_TLS_REJECT_UNAUTHORIZED=true


# =============================================================================
# GOOGLE OAUTH
# =============================================================================

GOOGLE_CLIENT_ID=<SET_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<ROTATE_AND_SET_GOOGLE_CLIENT_SECRET>

GOOGLE_CALLBACK_URL=http://localhost:3300/api/v1/auth/google/redirect


# =============================================================================
# AUDIT LOG
# =============================================================================

AUDIT_LOG_ENABLED=true
AUDIT_MASK_SENSITIVE=true

AUDIT_RETENTION_DAYS=30


# =============================================================================
# DATABASE BACKUP
# =============================================================================

BACKUP_DIRECTORY=backups
BACKUP_OFFSITE_DIRECTORY=

BACKUP_RETENTION_DAYS=30

BACKUP_DRILL_ENABLED=false


# =============================================================================
# HEALTH CHECKS
# =============================================================================

HEALTH_CACHE_MS=5000

# 0.90 = 90% disk utilization threshold.
HEALTH_DISK_THRESHOLD=0.9

# 512 MiB
HEALTH_HEAP_LIMIT=536870912

# 1 GiB
HEALTH_RSS_LIMIT=1073741824
