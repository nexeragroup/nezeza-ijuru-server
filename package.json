    "start": "nest start",
    "start:api": "APP_ROLE=api nest start",
    "start:worker": "APP_ROLE=worker nest start",
    "start:all": "APP_ROLE=all nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "lint": "oxlint src/ test/",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm test:http",
    "start:worker:prod": "NODE_ENV=production APP_ROLE=worker node dist/main",
    "db:bootstrap": "NODE_ENV=production node dist/database/bootstrap.js",
    "test:http": "pnpm build && node --test test/*.test.cjs"
  },
